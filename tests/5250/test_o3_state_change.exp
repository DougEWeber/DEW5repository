#!/usr/bin/env expect
#
# Sanity test: order state change. Uses the order test_o1_entry_accept.exp
# created and accepted (currently IN PROCESS), moves it to SHIPPED via
# ORDSTAT, and confirms the new state sticks by reopening it.

source [file join [file dirname [info script]] .. .. .claude 5250-config.exp]
source [file join [file dirname [info script]] lib.exp]
source [file join [file dirname [info script]] report_helpers.exp]
source [file join [file dirname [info script]] ordentr_helpers.exp]
source [file join [file dirname [info script]] .order_state]

set screen [open_ordstat]
if {![string match "*ORDER STATE*" $screen]} {
    test_fail "did not reach ORDSTAT's order-id prompt" $screen
}

set screen [open_order_status $::OORDERID]
if {[string match "*NOT ON FILE*" $screen] || [string match "*NOT YET ACCEPTED*" $screen]} {
    test_fail "order $::OORDERID rejected by ORDSTAT" $screen
}
if {![string match "*IN PROCESS*" $screen]} {
    test_fail "order did not show IN PROCESS before the state change" $screen
}

set screen [change_state "S"]
if {[string match "*INVALID STATE*" $screen]} {
    test_fail "ship code rejected as invalid" $screen
}
if {![string match "*ORDER STATE*" $screen]} {
    test_fail "did not return to the order-id prompt after a non-cancel state change" $screen
}

set screen [open_order_status $::OORDERID]
if {![string match "*SHIPPED*" $screen]} {
    test_fail "order did not show SHIPPED after the state change" $screen
}

pass "changed order $::OORDERID from IN PROCESS to SHIPPED"
